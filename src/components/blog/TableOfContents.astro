---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;
// Hanya ambil heading H2 dan H3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav aria-label="Daftar Isi Artikel" class="p-4 bg-[#F8F9FA] border border-[#E5E5E5] rounded-xl my-6">
    <div class="font-bold text-xs uppercase tracking-wider text-[#14213D] mb-2.5 flex items-center justify-between">
      <span>Daftar Isi Artikel</span>
      <span class="text-[10px] text-[#525252] font-normal">Klik untuk lompat</span>
    </div>
    <ul class="space-y-1.5 list-none p-0 m-0 text-xs">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? 'pl-4 border-l-2 border-[#E5E5E5]' : ''}>
          <a
            href={`#${h.slug}`}
            class="text-[#525252] hover:text-[#14213D] hover:underline underline-offset-2 transition-colors block py-0.5 leading-snug"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

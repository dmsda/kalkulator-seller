---
import BlogCard from './BlogCard.astro';

interface Props {
  currentSlug: string;
  category?: string;
  allPosts: Array<any>;
}

const { currentSlug, category, allPosts } = Astro.props;

// Filter out current post & drafts, prioritize same category
const otherPosts = allPosts.filter(
  (p) => (p.data.slug || p.id) !== currentSlug && !p.data.draft
);

const sameCategoryPosts = otherPosts.filter((p) => p.data.category === category);
const differentPosts = otherPosts.filter((p) => p.data.category !== category);

const related = [...sameCategoryPosts, ...differentPosts].slice(0, 3);
---

{related.length > 0 && (
  <section class="mt-16 pt-10 border-t border-[#E5E5E5] space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold text-[#14213D]">Artikel Terkait Lainnya</h2>
      <a href="/blog/" class="text-xs text-[#14213D] font-semibold underline hover:no-underline min-h-[36px] inline-flex items-center">
        Lihat Semua Artikel &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {related.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
)}

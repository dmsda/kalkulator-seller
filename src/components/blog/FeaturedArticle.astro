---
import { calculateReadingTime } from '../../utils/readingTime.js';

import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'> | any;
}

const { post } = Astro.props;
const slug = post.data.slug || post.id;
const url = `/blog/${slug}/`;
const readingTime = calculateReadingTime(post.body || post.data.description);
const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(post.data.publishedAt);
---

<section class="bg-white border border-[#E5E5E5] rounded-2xl overflow-hidden hover:border-[#14213D] transition-all duration-200 group mb-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
    <!-- Featured Image -->
    <a href={url} class="lg:col-span-7 block aspect-video w-full overflow-hidden bg-[#F4F5F7]" tabindex="-1" aria-hidden="true">
      {post.data.featuredImage ? (
        <img
          src={post.data.featuredImage}
          alt={post.data.imageAlt || post.data.title}
          class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
          loading="eager"
          decoding="async"
          width="800"
          height="450"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-[#14213D] font-bold text-2xl bg-[#F8F9FA]">
          KalkulatorSeller Featured
        </div>
      )}
    </a>

    <!-- Featured Content -->
    <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between space-y-4">
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-bold uppercase tracking-wider bg-[#14213D] text-white px-2.5 py-1 rounded">
            Pilihan Editor
          </span>
          <span class="text-xs font-semibold text-[#525252] bg-[#F4F5F7] px-2.5 py-1 rounded">
            {post.data.category || 'Tips Jualan Online'}
          </span>
        </div>

        <h2 class="text-xl sm:text-2xl font-extrabold text-[#14213D] leading-tight group-hover:text-[#FCA311] transition-colors">
          <a href={url} class="focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#14213D] rounded-xs">
            {post.data.title}
          </a>
        </h2>

        <p class="text-xs sm:text-sm text-[#525252] leading-relaxed line-clamp-3">
          {post.data.excerpt || post.data.description}
        </p>
      </div>

      <div class="pt-4 border-t border-[#E5E5E5] flex items-center justify-between text-xs text-[#525252]">
        <div class="flex items-center gap-2">
          <span class="font-medium text-[#14213D]">{post.data.author || 'Tim KalkulatorSeller'}</span>
          <span>&bull;</span>
          <time datetime={post.data.publishedAt.toISOString()}>{formattedDate}</time>
        </div>
        <span class="font-mono text-[11px]">{readingTime.text}</span>
      </div>

      <div>
        <a
          href={url}
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#14213D] group-hover:text-[#FCA311] transition-colors min-h-[40px]"
        >
          <span>Baca Artikel Lengkap</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

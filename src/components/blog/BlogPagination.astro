---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

if (totalPages <= 1) {
  return null;
}

const cleanBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const prevUrl = currentPage === 2 ? cleanBaseUrl : `${cleanBaseUrl}page/${currentPage - 1}/`;
const nextUrl = `${cleanBaseUrl}page/${currentPage + 1}/`;

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<nav aria-label="Navigasi Halaman Artikel" class="mt-12 flex items-center justify-center gap-1.5 sm:gap-2">
  <!-- Previous Button -->
  {currentPage > 1 ? (
    <a
      href={prevUrl}
      class="px-3.5 py-2 min-h-[44px] inline-flex items-center text-xs font-semibold rounded-lg border border-[#E5E5E5] text-[#14213D] hover:bg-[#F4F5F7] transition-colors"
      aria-label="Ke halaman sebelumnya"
    >
      &larr; <span class="hidden sm:inline ml-1">Sebelumnya</span>
    </a>
  ) : (
    <span
      class="px-3.5 py-2 min-h-[44px] inline-flex items-center text-xs font-medium rounded-lg border border-[#E5E5E5] text-[#9CA3AF] opacity-50 cursor-not-allowed"
      aria-disabled="true"
    >
      &larr; <span class="hidden sm:inline ml-1">Sebelumnya</span>
    </span>
  )}

  <!-- Page Numbers -->
  <div class="flex items-center gap-1">
    {pages.map((p) => {
      const isCurrent = p === currentPage;
      const pageUrl = p === 1 ? cleanBaseUrl : `${cleanBaseUrl}page/${p}/`;

      return (
        <a
          href={pageUrl}
          aria-current={isCurrent ? 'page' : undefined}
          class={`min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-xs font-semibold rounded-lg transition-colors ${
            isCurrent
              ? 'bg-[#F4F5F7] text-[#14213D] font-bold border border-[#14213D] shadow-2xs'
              : 'border border-[#E5E5E5] text-[#525252] hover:text-[#14213D] hover:bg-[#F4F5F7]'
          }`}
          aria-label={`Halaman ${p}`}
        >
          {p}
        </a>
      );
    })}
  </div>

  <!-- Next Button -->
  {currentPage < totalPages ? (
    <a
      href={nextUrl}
      class="px-3.5 py-2 min-h-[44px] inline-flex items-center text-xs font-semibold rounded-lg border border-[#E5E5E5] text-[#14213D] hover:bg-[#F4F5F7] transition-colors"
      aria-label="Ke halaman berikutnya"
    >
      <span class="hidden sm:inline mr-1">Berikutnya</span> &rarr;
    </a>
  ) : (
    <span
      class="px-3.5 py-2 min-h-[44px] inline-flex items-center text-xs font-medium rounded-lg border border-[#E5E5E5] text-[#9CA3AF] opacity-50 cursor-not-allowed"
      aria-disabled="true"
    >
      <span class="hidden sm:inline mr-1">Berikutnya</span> &rarr;
    </span>
  )}
</nav>

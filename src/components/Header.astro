---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Shopee', href: '/shopee/' },
  { label: 'TikTok Shop', href: '/tiktok-shop/' },
  { label: 'Tokopedia', href: '/tokopedia/' },
  { label: 'Tarif', href: '/tarif/' },
  { label: 'Panduan', href: '/panduan/' },
  { label: 'Blog', href: '/blog/' },
];
---

<header class="border-b border-[#E5E5E5] bg-white">
  <div class="max-w-[1160px] mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand / Wordmark -->
    <a href="/" class="flex items-center text-[#14213D] no-underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#14213D] rounded-sm py-1">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="KalkulatorSeller - Hitung untung & potongan marketplace"
          class="h-8 sm:h-9 w-auto object-contain"
          width="146"
          height="36"
          loading="eager"
          decoding="async"
        />
      </picture>
      <span class="sr-only">KalkulatorSeller — Beranda</span>
    </a>

    <!-- Desktop / Tablet Navigation (Hidden on mobile < md) -->
    <nav aria-label="Navigasi Utama" class="hidden md:flex items-center gap-1.5 lg:gap-2">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`min-h-[44px] inline-flex items-center px-3.5 py-2 text-xs lg:text-sm font-medium rounded-lg transition-colors ${
              isActive
                ? 'bg-[#14213D] text-white font-semibold shadow-2xs'
                : 'text-[#525252] hover:text-[#14213D] hover:bg-[#F3F4F6]'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Mobile Menu Button (< md) -->
    <button
      type="button"
      id="mobile-menu-toggle-btn"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Buka menu navigasi"
      class="md:hidden w-11 h-11 inline-flex items-center justify-center border border-[#E5E5E5] rounded-lg text-[#14213D] hover:bg-[#F8F9FA] transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#14213D] cursor-pointer"
    >
      <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation Panel -->
  <div id="mobile-nav-panel" class="hidden md:hidden border-t border-[#E5E5E5] bg-white">
    <nav aria-label="Navigasi Menu Mobile" class="px-3 py-2 space-y-0.5">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`min-h-[44px] flex items-center justify-between px-3.5 py-2 text-sm rounded-md transition-colors ${
              isActive
                ? 'text-[#14213D] font-semibold bg-[#F4F5F7]'
                : 'text-[#525252] hover:text-[#14213D] hover:bg-[#F8F9FA] font-medium'
            }`}
          >
            <span>{item.label}</span>
            {isActive && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#14213D]" aria-hidden="true"></span>
            )}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
  const navPanel = document.getElementById('mobile-nav-panel');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function setMenuOpen(isOpen: boolean) {
    if (!toggleBtn || !navPanel) return;
    toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    toggleBtn.setAttribute('aria-label', isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    if (isOpen) {
      navPanel.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      navPanel.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  toggleBtn?.addEventListener('click', () => {
    const isCurrentlyOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isCurrentlyOpen);
  });

  // Close on Escape
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggleBtn.focus();
    }
  });

  // Close on click outside
  document.addEventListener('click', (e: MouseEvent) => {
    if (toggleBtn?.getAttribute('aria-expanded') === 'true') {
      const target = e.target as Node | null;
      if (target && !toggleBtn.contains(target) && !navPanel?.contains(target)) {
        setMenuOpen(false);
      }
    }
  });
</script>

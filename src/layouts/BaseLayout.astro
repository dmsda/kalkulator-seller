---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  currentPath?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  image?: string;
}

const {
  title,
  description = 'Kalkulator keuntungan dan potongan biaya marketplace Shopee, TikTok Shop, dan Tokopedia untuk penjual online Indonesia. Hitung modal, biaya admin, dan keuntungan bersih.',
  canonicalUrl,
  currentPath = Astro.url.pathname,
  noindex = false,
  jsonLd,
  image,
} = Astro.props;

// Normalisasi canonical URL secara konsisten dengan trailingSlash: 'always'
const resolvedCanonical = canonicalUrl || new URL(
  Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
  Astro.site || 'https://kalkulatorseller.pages.dev'
).href;

// Pemetaan Open Graph Image spesifik per halaman
const defaultImageMap: Record<string, string> = {
  '/': '/og-home.png',
  '/shopee': '/og-shopee.png',
  '/shopee/': '/og-shopee.png',
  '/tiktok-shop': '/og-tiktok-shop.png',
  '/tiktok-shop/': '/og-tiktok-shop.png',
  '/tokopedia': '/og-tokopedia.png',
  '/tokopedia/': '/og-tokopedia.png',
  '/tarif': '/og-tarif.png',
  '/tarif/': '/og-tarif.png',
  '/panduan': '/og-panduan.png',
  '/panduan/': '/og-panduan.png',
  '/privacy-policy': '/og-privacy-policy.png',
  '/privacy-policy/': '/og-privacy-policy.png',
  '/terms': '/og-terms.png',
  '/terms/': '/og-terms.png',
};

const resolvedImagePath = image || defaultImageMap[currentPath] || '/og-image.png';
const resolvedOgImage = new URL(resolvedImagePath, Astro.site || 'https://kalkulatorseller.pages.dev').href;

const schemaArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — KalkulatorSeller</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KalkulatorSeller" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={`${title} — KalkulatorSeller`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1734" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content={`${title} — KalkulatorSeller`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — KalkulatorSeller`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data (JSON-LD) -->
    {schemaArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-black font-sans antialiased overflow-x-hidden w-full relative">
    <Header currentPath={currentPath} />
    <main id="main-content" class="flex-1 w-full max-w-[1160px] mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 pb-28 lg:pb-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>

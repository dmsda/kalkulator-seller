---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan (404)" currentPath="/404" noindex={true}>
  <div class="py-16 text-center max-w-md mx-auto space-y-4">
    <div class="text-4xl font-extrabold text-[#14213D] font-mono">404</div>
    <h1 class="text-xl font-bold text-[#14213D]">Halaman Tidak Ditemukan</h1>
    <p class="text-xs sm:text-sm text-[#525252] leading-relaxed">
      Halaman yang Anda cari tidak tersedia atau alamatnya salah. Yuk kembali ke kalkulator utama untuk mulai menghitung keuntungan produk Anda.
    </p>
    <div class="pt-2">
      <a
        href="/"
        class="inline-block px-4 py-2 bg-[#14213D] text-white text-xs sm:text-sm font-semibold rounded-md hover:bg-[#0c1527] transition-colors"
      >
        Kembali ke Kalkulator
      </a>
    </div>
  </div>
</BaseLayout>

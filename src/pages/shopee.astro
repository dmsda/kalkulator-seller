---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import SavedSkuList from '../components/SavedSkuList.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Beranda',
      'item': 'https://kalkulatorseller.pages.dev/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Kalkulator Shopee',
      'item': 'https://kalkulatorseller.pages.dev/shopee/',
    },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'Kalkulator Biaya Admin & Keuntungan Shopee',
  'url': 'https://kalkulatorseller.pages.dev/shopee/',
  'applicationCategory': 'BusinessApplication',
  'operatingSystem': 'All',
  'browserRequirements': 'Requires JavaScript. Requires HTML5.',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'IDR',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Apa perbedaan potongan biaya admin Non-Star, Star, dan Shopee Mall?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Shopee membedakan potongan biaya administrasi berdasarkan status toko dan jenis produk yang dijual. Toko biasa (Non-Star) dipotong sekitar 4,0% – 6,5%, toko Star/Star+ sekitar 4,75% – 7,5%, sedangkan Shopee Mall dipotong 6,5% – 9,5% dari harga jual setelah diskon toko.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Apakah ada batas maksimal (cap) untuk Biaya Gratis Ongkir XTRA Shopee?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Ya, ada. Sesuai ketentuan resmi Shopee, biaya layanan program Gratis Ongkir XTRA dikenakan tarif 4,0% dengan batas potongan maksimal sebesar Rp10.000 per satu barang yang terjual.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Bagaimana biaya proses pesanan dihitung jika pembeli membeli beberapa barang sekaligus di Shopee?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Biaya proses pesanan (Rp1.000) hanya dikenakan 1 kali untuk satu keranjang belanja checkout, berapapun jumlah barang yang dibeli pembeli dalam pesanan tersebut.',
      },
    },
  ],
};
---

<BaseLayout
  title="Kalkulator Shopee: Hitung Biaya Admin & Keuntungan Jualan"
  description="Hitung potongan biaya admin Shopee Non-Star, Star, Mall, Gratis Ongkir XTRA, dan ketahui sisa keuntungan bersih jualan Anda secara akurat."
  currentPath="/shopee"
  jsonLd={[breadcrumbSchema, webAppSchema, faqSchema]}
>
  <nav aria-label="Breadcrumb" class="text-xs text-[#525252] mb-3">
    <ol class="flex items-center gap-1.5 list-none p-0 m-0">
      <li><a href="/" class="hover:underline text-[#14213D] min-h-[36px] inline-flex items-center">Beranda</a></li>
      <li>/</li>
      <li class="font-semibold text-[#14213D] min-h-[36px] inline-flex items-center">Shopee</li>
    </ol>
  </nav>

  <div class="mb-6">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#14213D] mb-1.5">
      Kalkulator Biaya Admin & Keuntungan Shopee
    </h1>
    <p class="text-xs sm:text-sm text-[#525252] max-w-2xl leading-relaxed">
      Hitung perkiraan potongan biaya admin toko biasa (Non-Star), Star/Star+, Shopee Mall, biaya Gratis Ongkir XTRA, dan biaya proses pesanan sebelum memasang harga di etalase toko.
    </p>
  </div>

  <Calculator initialPlatform="shopee" />

  <SavedSkuList />

  <!-- Educational Section: Shopee Fee Guide -->
  <section class="mt-16 pt-8 border-t border-[#E5E5E5] space-y-6 max-w-3xl">
    <div>
      <h2 class="text-lg font-bold text-[#14213D] mb-2">
        Panduan Memahami Potongan Biaya Admin Shopee untuk Seller
      </h2>
      <p class="text-xs sm:text-sm text-[#525252] leading-relaxed">
        Saat berjualan di Shopee, total uang yang dicairkan ke Saldo Penjual tidak sama dengan harga produk di etalase. Shopee memotong sejumlah biaya layanan resmi tergantung pada status toko dan program promosi yang Anda ikuti:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
      <div class="p-4 bg-white border border-[#E5E5E5] rounded-md space-y-1.5">
        <div class="font-bold text-[#14213D]">1. Biaya Administrasi</div>
        <p class="text-[#525252] leading-relaxed">
          Dikenakan per produk terjual berdasarkan tingkatan toko: Non-Star (4,0%–6,5%), Star / Star+ (4,75%–7,5%), atau Mall (6,5%–9,5%).
        </p>
      </div>
      <div class="p-4 bg-white border border-[#E5E5E5] rounded-md space-y-1.5">
        <div class="font-bold text-[#14213D]">2. Gratis Ongkir XTRA</div>
        <p class="text-[#525252] leading-relaxed">
          Biaya layanan program sebesar 4,0% dari harga barang dengan batas maksimal (cap) Rp10.000 per unit barang yang terjual.
        </p>
      </div>
      <div class="p-4 bg-white border border-[#E5E5E5] rounded-md space-y-1.5">
        <div class="font-bold text-[#14213D]">3. Biaya Proses Pesanan</div>
        <p class="text-[#525252] leading-relaxed">
          Biaya penanganan tetap sebesar Rp1.000 per transaksi checkout pembeli, terlepas dari berapa banyak barang yang dibeli sekaligus.
        </p>
      </div>
    </div>

    <!-- Practical Tips for Shopee Sellers -->
    <div class="p-5 bg-[#F8F9FA] border border-[#E5E5E5] rounded-lg space-y-3 text-xs leading-relaxed">
      <h3 class="text-sm font-bold text-[#14213D]">Cara Menentukan Harga Jual Shopee Agar Tidak Boncos</h3>
      <ol class="space-y-1.5 list-decimal pl-4 text-[#525252]">
        <li><strong>Periksa Kategori Barang:</strong> Kategori Fashion biasanya memiliki tarif persentase admin lebih tinggi dibanding Kategori Elektronik.</li>
        <li><strong>Pertimbangkan Diskon Toko / Voucher:</strong> Potongan persentase admin Shopee dihitung dari harga jual <em>setelah</em> dikurangi voucher diskon yang Anda tanggung.</li>
        <li><strong>Manfaatkan Batas Maksimal (Cap):</strong> Untuk produk bernilai tinggi (misal di atas Rp250.000), potongan Gratis Ongkir XTRA tidak akan melebihi Rp10.000 per unit karena terlindungi aturan cap Shopee.</li>
        <li><strong>Gunakan Fitur "Cari Harga Jual Ideal":</strong> Masukkan target uang bersih yang Anda inginkan di tab atas kalkulator agar harga jual dihitung otomatis.</li>
      </ol>
      <div class="pt-2 text-[11px] flex gap-3 text-[#14213D] font-medium">
        <a href="/tarif#shopee" class="underline hover:no-underline">Lihat tabel tarif lengkap Shopee &rarr;</a>
        <a href="/panduan/" class="underline hover:no-underline">Baca panduan hitung modal HPP &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Platform Specific FAQ -->
  <section class="mt-12 pt-8 border-t border-[#E5E5E5] space-y-4 max-w-3xl">
    <h2 class="text-lg font-bold text-[#14213D]">Pertanyaan yang Sering Ditanyakan seputar Biaya Shopee</h2>

    <details class="p-3.5 border border-[#E5E5E5] rounded-md bg-white">
      <summary class="font-semibold text-xs sm:text-sm text-[#14213D] cursor-pointer">
        Apa perbedaan potongan biaya admin Non-Star, Star, dan Shopee Mall?
      </summary>
      <p class="text-xs text-[#525252] mt-2 leading-relaxed">
        Shopee membedakan potongan biaya administrasi berdasarkan status toko dan jenis produk yang dijual. Toko biasa (Non-Star) dipotong sekitar 4,0% – 6,5%, toko Star/Star+ sekitar 4,75% – 7,5%, sedangkan Shopee Mall dipotong 6,5% – 9,5% dari harga jual setelah diskon toko.
      </p>
    </details>

    <details class="p-3.5 border border-[#E5E5E5] rounded-md bg-white">
      <summary class="font-semibold text-xs sm:text-sm text-[#14213D] cursor-pointer">
        Apakah ada batas maksimal (cap) untuk Biaya Gratis Ongkir XTRA?
      </summary>
      <p class="text-xs text-[#525252] mt-2 leading-relaxed">
        Ya, ada. Sesuai ketentuan resmi Shopee, biaya layanan program Gratis Ongkir XTRA dikenakan tarif 4,0% dengan batas potongan maksimal sebesar Rp10.000 per satu barang yang terjual.
      </p>
    </details>

    <details class="p-3.5 border border-[#E5E5E5] rounded-md bg-white">
      <summary class="font-semibold text-xs sm:text-sm text-[#14213D] cursor-pointer">
        Bagaimana biaya proses pesanan dihitung jika pembeli membeli beberapa barang sekaligus?
      </summary>
      <p class="text-xs text-[#525252] mt-2 leading-relaxed">
        Biaya proses pesanan (Rp1.000) hanya dikenakan 1 kali untuk satu keranjang belanja checkout, berapapun jumlah barang yang dibeli pembeli dalam pesanan tersebut.
      </p>
    </details>
  </section>
</BaseLayout>

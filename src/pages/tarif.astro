---
import BaseLayout from '../layouts/BaseLayout.astro';
import shopeeConfig from '../data/tariffs/shopee.json';
import tiktokConfig from '../data/tariffs/tiktok-shop.json';
import tokopediaConfig from '../data/tariffs/tokopedia.json';

const allTariffs = [
  {
    platform: 'Shopee',
    slug: 'shopee',
    calcUrl: '/shopee',
    data: shopeeConfig,
    references: [
      { label: 'Ringkasan Biaya Admin Shopee (Pusat Edukasi)', url: 'https://seller.shopee.co.id/edu/article/3489' },
    ],
  },
  {
    platform: 'TikTok Shop',
    slug: 'tiktok-shop',
    calcUrl: '/tiktok-shop',
    data: tiktokConfig,
    references: [
      { label: 'Pembaruan Biaya Komisi & Layanan TikTok Shop (Shop | Tokopedia)', url: 'https://seller-id.tokopedia.com/university/essay?knowledge_id=7753828090824449' },
    ],
  },
  {
    platform: 'Tokopedia',
    slug: 'tokopedia',
    calcUrl: '/tokopedia',
    data: tokopediaConfig,
    references: [
      { label: 'Pusat Bantuan: Biaya Layanan Regular & Power Merchant', url: 'https://www.tokopedia.com/help/article/biaya-layanan-seller-regular-dan-power-shop' },
      { label: 'Pusat Edukasi: Rincian Biaya Layanan', url: 'https://seller-id.tokopedia.com/university/essay?knowledge_id=5411650459305729' },
      { label: 'Pusat Edukasi: Skema Bebas Ongkir', url: 'https://seller-id.tokopedia.com/university/essay?knowledge_id=6385751723132688' },
    ],
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Beranda',
      'item': 'https://kalkulatorseller.pages.dev/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Daftar Tarif Marketplace',
      'item': 'https://kalkulatorseller.pages.dev/tarif/',
    },
  ],
};
---

<BaseLayout
  title="Daftar Biaya Admin & Potongan Marketplace 2026 (Shopee, TikTok, Tokopedia)"
  description="Daftar lengkap aturan biaya administrasi, komisi, dan biaya gratis ongkir Shopee, TikTok Shop, dan Tokopedia dengan tautan bantuan resmi."
  currentPath="/tarif"
  image="/og-tarif.png"
  jsonLd={breadcrumbSchema}
>
  <nav aria-label="Breadcrumb" class="text-xs text-[#525252] mb-3">
    <ol class="flex items-center gap-1.5 list-none p-0 m-0">
      <li><a href="/" class="hover:underline text-[#14213D] min-h-[36px] inline-flex items-center">Beranda</a></li>
      <li>/</li>
      <li class="font-semibold text-[#14213D] min-h-[36px] inline-flex items-center">Daftar Tarif Marketplace</li>
    </ol>
  </nav>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#14213D] mb-2">
      Daftar Aturan & Potongan Biaya Marketplace 2026
    </h1>
    <p class="text-xs sm:text-sm text-[#525252] max-w-2xl leading-relaxed">
      KalkulatorSeller menghitung keuntungan Anda berdasarkan data aturan resmi yang dipublikasikan oleh masing-masing marketplace. Di halaman ini, Anda bisa memeriksa rincian persentase setiap potongan, batas maksimal biaya, tanggal berlaku, dan tautan bantuan resminya.
    </p>

    <!-- Quick Jump Links -->
    <div class="flex items-center flex-wrap gap-2 text-xs mt-4">
      <span class="font-semibold text-[#14213D] mr-1">Lompat ke Platform:</span>
      <a href="#shopee" class="min-h-[36px] px-3 py-1.5 bg-white border border-[#E5E5E5] rounded-md hover:border-[#14213D] text-[#14213D] font-medium inline-flex items-center">Tarif Shopee &darr;</a>
      <a href="#tiktok-shop" class="min-h-[36px] px-3 py-1.5 bg-white border border-[#E5E5E5] rounded-md hover:border-[#14213D] text-[#14213D] font-medium inline-flex items-center">Tarif TikTok Shop &darr;</a>
      <a href="#tokopedia" class="min-h-[36px] px-3 py-1.5 bg-white border border-[#E5E5E5] rounded-md hover:border-[#14213D] text-[#14213D] font-medium inline-flex items-center">Tarif Tokopedia &darr;</a>
    </div>
  </div>

  <div class="space-y-12">
    {allTariffs.map(({ platform, slug, calcUrl, data, references }) => (
      <section id={slug} class="border border-[#E5E5E5] rounded-lg p-5 bg-white space-y-4 scroll-mt-20">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#E5E5E5] pb-3">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-[#14213D]">{platform}</h2>
            <div class="text-xs text-[#525252]">
              Versi Data: {data.version} &bull; Berlaku Sejak: {data.effectiveFrom} &bull; Terakhir Dicek: {data.lastVerified}
            </div>
          </div>
          <div class="flex items-center gap-3">
            <a
              href={calcUrl}
              class="text-xs bg-[#14213D] text-white px-3 py-1.5 rounded font-medium hover:bg-[#0c1527] min-h-[36px] inline-flex items-center"
            >
              Buka Kalkulator {platform} &rarr;
            </a>
            <a
              href={data.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-[#14213D] font-semibold underline hover:no-underline min-h-[36px] inline-flex items-center"
            >
              Aturan Utama &rarr;
            </a>
          </div>
        </div>

        <!-- Official References Links Box -->
        <div class="p-3 bg-[#F8F9FA] rounded border border-[#E5E5E5] text-xs space-y-1.5">
          <div class="font-semibold text-[#14213D]">Rujukan Resmi {platform}:</div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px]">
            {references.map((ref) => (
              <a
                href={ref.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#14213D] underline hover:no-underline font-medium inline-flex items-center gap-1 min-h-[28px]"
              >
                <span>{ref.label}</span>
                <span aria-hidden="true">&nearr;</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Mobile Scroll Hint (< sm) -->
        <div class="sm:hidden text-[11px] text-[#525252] flex items-center gap-1.5 bg-[#F8F9FA] px-3 py-1.5 rounded border border-[#E5E5E5]">
          <span aria-hidden="true">&larr;</span>
          <span>Geser tabel ke samping untuk melihat batas potongan & status</span>
          <span aria-hidden="true">&rarr;</span>
        </div>

        <div class="overflow-x-auto hide-scrollbar">
          <table class="w-full text-left text-xs border-collapse font-mono min-w-[560px]">
            <thead>
              <tr class="border-b border-[#E5E5E5] text-[#525252] font-semibold">
                <th class="py-2.5 pr-3 font-sans">Komponen Biaya</th>
                <th class="py-2.5 px-3 font-sans">Jenis</th>
                <th class="py-2.5 px-3 font-sans">Persentase / Tarif</th>
                <th class="py-2.5 px-3 font-sans">Dihitung Dari</th>
                <th class="py-2.5 px-3 font-sans">Dikenakan</th>
                <th class="py-2.5 px-3 font-sans">Batas Maksimal</th>
                <th class="py-2.5 pl-3 font-sans">Status Data</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#E5E5E5] text-[11px]">
              {data.fees.map((f) => (
                <tr class="hover:bg-gray-50">
                  <td class="py-2 pr-3 font-medium text-[#14213D] font-sans">
                    {f.name}
                    <div class="text-[10px] text-[#525252] font-sans">{f.notes}</div>
                  </td>
                  <td class="py-2 px-3 text-[#525252] uppercase">{f.type === 'percentage' ? 'Persen' : 'Nominal Tetap'}</td>
                  <td class="py-2 px-3 font-semibold text-[#14213D]">
                    {f.type === 'percentage' ? `${(f.rate * 100).toFixed(2)}%` : `Rp ${new Intl.NumberFormat('id-ID').format(f.amount)}`}
                  </td>
                  <td class="py-2 px-3 text-[#525252]">{f.basis === 'effective_price' ? 'Harga Jual Bersih' : f.basis}</td>
                  <td class="py-2 px-3 text-[#525252]">{f.unit === 'per_item' ? 'Per Barang' : 'Per Pesanan'}</td>
                  <td class="py-2 px-3 text-[#525252]">
                    {f.cap ? `Maks Rp ${new Intl.NumberFormat('id-ID').format(f.cap)} (${f.capScope === 'per_item' ? 'Per Barang' : 'Per Pesanan'})` : 'Tanpa Batas'}
                  </td>
                  <td class="py-2 pl-3">
                    <span class={`text-[11px] font-sans font-medium ${
                      f.isAssumption ? 'text-[#B45309]' : 'text-[#047857]'
                    }`}>
                      {f.isAssumption ? 'Aturan Publik' : 'Terverifikasi Resmi'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
